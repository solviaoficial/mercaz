# Copie para .env. O modo inicial não cobra dinheiro.
APP_URL=http://localhost:3000
HOST_PORT=3000
PAYMENT_MODE=demo
SEED_DEMO=true
# Defina uma senha de 12+ caracteres ANTES da primeira inicialização.
DEMO_PASSWORD=
DATA_DIR=data
TRUST_PROXY=0

# Produção: banco e autenticação Supabase. Nunca coloque estas chaves no GitHub.
# Use a string de conexão Session pooler do Supabase, com sslmode=require.
DATABASE_URL=
DATABASE_CA_CERT=
DB_POOL_SIZE=5
AUTH_PROVIDER=supabase
SUPABASE_URL=https://whhbymylamucawmofqdg.supabase.co
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_AUTH_ENABLED=false

# Configure quando estiver pronto para operar pagamentos reais.
# Cada vendedor conecta a própria conta por OAuth na área da loja.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# Gere 32 bytes em hex: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
PLATFORM_FEE_BPS=500

# Identidade e condições do operador; revise app/info.tsx.
OPERATOR_NAME=Mercaz
SUPPORT_EMAIL=
POLICIES_APPROVED=false
# E-mails de contas autorizadas a acessar /moderacao, separados por vírgula.
ADMIN_EMAILS=

# Opcional. Sem chave, o assistente fornece um checklist explícito, sem IA.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
